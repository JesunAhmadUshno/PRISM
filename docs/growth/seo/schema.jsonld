{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["SoftwareApplication", "WebApplication"],
      "@id": "https://prism.example.com/#software",
      "name": "PRISM",
      "alternateName": "PRISM browser analytics",
      "url": "https://prism.example.com/",
      "description": "PRISM is a browser-based data analytics application. It parses Excel, CSV and XML files and computes descriptive and inferential statistics and charts inside the browser tab. Parsing runs in the page and statistical computation runs in a Web Worker using Python compiled to WebAssembly. No file contents are transmitted to a server.",
      "disambiguatingDescription": "Unrelated to the United States National Security Agency surveillance programme of the same name.",
      "applicationCategory": "BusinessApplication",
      "applicationSubCategory": "Data analysis and statistics",
      "operatingSystem": "Any operating system with a modern web browser",
      "browserRequirements": "Requires a browser with WebAssembly and Web Worker support. JavaScript must be enabled.",
      "softwareVersion": "1.0.0",
      "inLanguage": "en",
      "isAccessibleForFree": true,
      "runtimePlatform": "WebAssembly",
      "softwareRequirements": "An internet connection is required for the first load in order to fetch the Python runtime from a public CDN. After that load, analysis runs locally in the browser.",
      "installUrl": "https://prism.example.com/",
      "featureList": [
        "Reads Excel, CSV and XML files chosen from the local disk",
        "Automatic column type inference",
        "Descriptive statistics including mean, median, standard deviation and quartiles",
        "One sample t test",
        "Independent samples t test",
        "Paired samples t test",
        "One way analysis of variance",
        "Two way analysis of variance",
        "Chi square test of independence",
        "Chi square goodness of fit test",
        "Fisher exact test",
        "Mann Whitney U test",
        "Wilcoxon signed rank test",
        "Kruskal Wallis test",
        "Pearson correlation",
        "Spearman rank correlation",
        "Linear regression",
        "F test of equality of variances",
        "Levene test for equality of variances",
        "Shapiro Wilk test for normality",
        "Chart generation with screen reader data table fallbacks",
        "Chart sonification for non visual review"
      ],
      "permissions": "None. PRISM does not request camera, microphone, location, notification, clipboard or persistent storage permissions. Files are read only after the user explicitly selects or drops them.",
